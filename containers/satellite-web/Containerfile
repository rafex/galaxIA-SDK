FROM node:22-alpine AS builder

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps/satellite-web ./apps/satellite-web
RUN npm ci --ignore-scripts
RUN npm run build -w packages/satellite-capabilities
RUN npm run build -w packages/satellite-capabilities-wasm
RUN npm run build -w apps/satellite-web

FROM docker.io/library/nginx:1.27-alpine
RUN apk add --no-cache openssl
COPY --from=builder /app/apps/satellite-web/dist /usr/share/nginx/html
COPY containers/satellite-web/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY containers/satellite-web/generate-cert.sh /docker-entrypoint.d/10-generate-cert.sh
RUN chmod 0755 /docker-entrypoint.d/10-generate-cert.sh

ENV CURP_CERT_CN=localhost
ENV CURP_CERT_SAN=DNS:localhost,IP:127.0.0.1
EXPOSE 443
