# Página del nodo móvil (Ephemeral Satellite): nginx sirve la app compilada
# sobre HTTPS; el navegador del teléfono es el nodo FHS (libp2p/WSS hacia Atlas
# y el Navigator). Contexto de build: raíz de galaxIA-SDK.
#   podman build -f containers/satellite-web/Containerfile -t galaxia-satellite-web:<commit> .

# 1) Rust -> WASM (aritmética y CURP). wasm-pack se fija para que el build sea
#    reproducible.
FROM docker.io/library/rust:1.97-bookworm AS wasm
RUN rustup target add wasm32-unknown-unknown \
 && cargo install wasm-pack --locked --version 0.13.1
WORKDIR /src/packages/satellite-capabilities-wasm
COPY packages/satellite-capabilities-wasm/Cargo.toml packages/satellite-capabilities-wasm/Cargo.lock ./
COPY packages/satellite-capabilities-wasm/src ./src
RUN wasm-pack build --target web --release --out-dir pkg --out-name satellite_capabilities --no-typescript

# 2) Vite. El paquete fhs-protocol es parte del workspace.
FROM docker.io/library/node:24-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/fhs-protocol ./packages/fhs-protocol
COPY packages/satellite-capabilities ./packages/satellite-capabilities
COPY packages/satellite-capabilities-wasm/package.json ./packages/satellite-capabilities-wasm/package.json
COPY apps/satellite-web ./apps/satellite-web
COPY --from=wasm /src/packages/satellite-capabilities-wasm/pkg ./packages/satellite-capabilities-wasm/pkg
RUN npm ci --ignore-scripts
RUN npm run build -w packages/fhs-protocol
RUN npm run build -w apps/satellite-web

# 3) nginx (HTTPS solo).
FROM docker.io/library/nginx:1.27-alpine
RUN apk add --no-cache openssl
COPY --from=builder /app/apps/satellite-web/dist /usr/share/nginx/html

# La imagen base trae un default.conf que compite por el puerto 80.
RUN rm -f /etc/nginx/conf.d/default.conf

COPY containers/satellite-web/nginx.conf.template /etc/nginx/satellite.conf.template
COPY containers/satellite-web/generate-p2p-config.sh /docker-entrypoint.d/09-generate-p2p-config.sh
COPY containers/satellite-web/generate-cert.sh /docker-entrypoint.d/10-generate-cert.sh
RUN chmod 0755 /docker-entrypoint.d/09-generate-p2p-config.sh /docker-entrypoint.d/10-generate-cert.sh

ENV SATELLITE_CERT_CN=localhost
ENV SATELLITE_CERT_SAN=DNS:localhost,IP:127.0.0.1
ENV FHS_BOOTSTRAP_ADDRS=
# Orígenes WSS que la CSP deja abrir al navegador (Atlas y Navigator).
ENV SATELLITE_CONNECT_SRC=

EXPOSE 443
CMD ["nginx", "-g", "daemon off;"]
