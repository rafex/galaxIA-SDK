{
  "name": "@rafex/galaxia-fhs-protocol",
  "version": "0.1.31",
  "private": false,
  "type": "module",
  "description": "Contratos compartidos del protocolo FHS v0.1.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants.js",
      "types": "./dist/constants.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./wire": {
      "import": "./dist/wire.js",
      "types": "./dist/wire.d.ts"
    },
    "./generated": {
      "import": "./dist/generated/fhs-protocol_pb.js",
      "types": "./dist/generated/fhs-protocol_pb.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafex/galaxIA-SDK.git",
    "directory": "packages/fhs-protocol"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate:proto": "node scripts/generate-proto.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0"
  }
}
